# Copy this file to `.env` and fill in real values for local development.
# In production, set these in the Vercel dashboard
# (Project Settings -> Environment Variables).

# ConvertKit / Kit v3 API key
KIT_API_KEY=

# Web3Forms access key (contact-form email notifications)
WEB3FORMS_ACCESS_KEY=

# Optional: ConvertKit form id used for subscriptions (defaults to 8861264)
# KIT_FORM_ID=
